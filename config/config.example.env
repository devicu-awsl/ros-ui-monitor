# RB5009 Monitor configuration
#
# Rename to config.env and put it in one of these places:
#   1. next to rb5009-monitor.exe  -> portable mode: the database is kept in
#      the same folder, so the whole folder can be moved or deleted as a unit
#   2. C:\ProgramData\RB5009Monitor\config.env  -> the per-machine default
# Either is picked up automatically; --config <path> overrides both.
#
# Process environment variables override values in this file.

# --- RouterOS connection ---------------------------------------------------
# Assumed RB5009 address
RBMON_ROUTER_HOST=192.168.88.1

# RouterOS API service ports (assumed): 8728 = api, 8729 = api-ssl (secure)
RBMON_ROUTER_API_PORT=8728
RBMON_ROUTER_API_SSL_PORT=8729

# REST base URL. RouterOS serves REST via the www-ssl service (HTTPS).
RBMON_ROUTER_URL=https://192.168.88.1

# Dedicated read-only monitoring user (do NOT use admin)
RBMON_ROUTER_USERNAME=rbmon
RBMON_ROUTER_PASSWORD=

# Path to the CA certificate that signed the router's TLS certificate.
# Leave empty to use the system trust store.
RBMON_ROUTER_CA_FILE=

# LAN bootstrap only: accept self-signed router certificates (true/false).
# Prefer installing a proper CA file instead.
RBMON_ROUTER_INSECURE_TLS=false

RBMON_ROUTER_TIMEOUT=10

# --- Web server ------------------------------------------------------------
# 127.0.0.1 = this PC only (Phase A).
# 0.0.0.0 = LAN mode (Phase B), same as passing --lan on the command line.
RBMON_BIND_HOST=127.0.0.1
RBMON_BIND_PORT=8000

# --- Dashboard login (Phase B / LAN mode) ----------------------------------
# This protects the dashboard itself. It is separate from the RouterOS
# credentials above, which never leave this PC.
# Setting either password field enables the login page.
RBMON_AUTH_USERNAME=admin

# Preferred: store only the hash. Generate it with:
#   rb5009-monitor.exe --hash-password
RBMON_AUTH_PASSWORD_HASH=

# Plaintext alternative, hashed at startup. Avoid if you can; anyone who can
# read this file can read the password.
RBMON_AUTH_PASSWORD=

# How long a browser stays signed in, and failed-login throttling.
RBMON_SESSION_HOURS=12
RBMON_LOGIN_MAX_ATTEMPTS=5
RBMON_LOGIN_WINDOW_SECONDS=300

# --- Storage ---------------------------------------------------------------
# Where monitor.db is written. Leave empty to use the default:
#   the folder holding this file when it sits next to the .exe (portable),
#   otherwise C:\ProgramData\RB5009Monitor
# Setting this overrides both.
#RBMON_DATA_DIR=

# --- Collector cadences (seconds) ------------------------------------------
RBMON_POLL_RESOURCE=5
RBMON_POLL_HEALTH=15
RBMON_POLL_INTERFACES=3
RBMON_MAX_CONCURRENT=3

# --- History ---------------------------------------------------------------
RBMON_RETENTION_HOURS=72

RBMON_LOG_LEVEL=INFO
